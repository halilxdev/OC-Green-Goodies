{% extends 'base.html.twig' %}

{% block title %}Liste de produits{% endblock %}


{% block body %}

<link href="{{ asset('css/products.css') }}" rel="stylesheet" type="text/css"/>

<section class="products"> {# SECTION CONVICTIONS #}

    <div class="title">
        <h2>Nos produits</h2>
    </div>

    <div class="productsMaxWidth">
        {% for product in products %}
            <a href="{{ path('getProduct', {id: product.id}) }}">
                <article>

                    <div class="coverImage">

                        <img src="{{ asset('images/' ~ product.picture) }}" alt="Image du projet : {{product.name}}">

                    </div>

                    <div class="infos">

                        <h3>{{product.name}}</h3>

                        <p class="desc">{{product.shortDescription}}</p>

                        <p class="price">{{ product.price|number_format(2, ',', '.') }} €</p>

                        <br>

                        <p class="show">Voir le produit</p>

                    </div>

                </article>
            </a>
        {% endfor %}
    </div>

</section>

{% endblock %}