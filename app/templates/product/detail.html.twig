{% extends 'base.html.twig' %}

{% block title %}{{product.name}}{% endblock %}

{% block body %}
 
<link href="{{ asset('css/product.css') }}" rel="stylesheet" type="text/css"/>

<section class="productPage">

    <section class="productPageMaxWidth">

        <div class="coverImage">
            <img src="{{ asset('images/' ~ product.picture) }}" alt="Image de couverture du produit suivant : {{product.name}}">
        </div>

        <div class="productInfos">

            <h1>{{product.name}}</h1>

            <p class="price">{{ product.price|number_format(2, ',', '.') }} €</p>

            <br><br>

            <h2>Description</h2>

            <p class="fullDescription">{{product.fullDescription}}</p>

            <div class="flexGrow"></div>

            {% if existing is empty %}
            <a href="{{ path('app_addToCart', {id:product.id}) }}">Ajouter au panier</a>
            {% else %}
            <form method="POST" action="{{ path('app_addToCart', {id:product.id}) }}">
                <input type="number" name="quantity" id="quantity" min="0" max="10" value="{{existing.quantity}}">
                <button type="submit">Mettre à jour</button>
            </form>
            {% endif %}
        
        </div>
    
    </section>

</section>

{% endblock %}