{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
 
<link href="{{ asset('css/register.css') }}" rel="stylesheet" type="text/css"/>
 
<section class="registerPage">
    <section class="registerPageMaxWidth">

        <div class="image">
            <img src="{{asset('images/788657d2e320dfe5e12e68fa906b8b707f49e6ad.jpg')}}" alt="Image de feuilles. Illustration">
        </div>

        <div class="form">

            <div class="title">
                <h1>Inscription</h1>
                <p class="subtitle">Tous les champs sont obligatoires</p>
            </div>

            {% if form_errors(registrationForm) is not empty %}
            <div class="error">
                <img src="{{asset('icons/alert-circle-sharp.svg')}}" alt="Icône d'erreur">
                <p>{{ form_errors(registrationForm) }}</p>
            </div>
            {% endif %}

            {{ form_start(registrationForm) }}
            
                <div class="colinput">
                    {{ form_label(registrationForm.lastname) }}
                    {{ form_widget(registrationForm.lastname) }}
                </div>
            
                <div class="colinput">
                    {{ form_label(registrationForm.firstname) }}
                    {{ form_widget(registrationForm.firstname) }}
                </div>

                <div class="colinput">
                    {{ form_label(registrationForm.email) }}
                    {{ form_widget(registrationForm.email) }}
                    {% if form_errors(registrationForm.email) is not empty %}
                        <div class="error">
                            <img src="{{asset('icons/alert-circle-sharp.svg')}}" alt="Icône d'erreur">
                            <p>{{ form_errors(registrationForm.email) }}</p>
                        </div>
                    {% endif %}
                </div>

                <div class="colinput">
                    {{ form_label(registrationForm.plainPassword1) }}
                    {{ form_widget(registrationForm.plainPassword1) }}
                    {% if form_errors(registrationForm.plainPassword1) is not empty or form_errors(registrationForm.plainPassword2) is not empty %}
                        <div class="error">
                            <img src="{{asset('icons/alert-circle-sharp.svg')}}" alt="Icône d'erreur">
                            <p>{{ form_errors(registrationForm.plainPassword1) }}</p>
                            <p>{{ form_errors(registrationForm.plainPassword2) }}</p>
                        </div>
                    {% endif %}
                </div>

                <div class="colinput">
                    {{ form_label(registrationForm.plainPassword2) }}
                    {{ form_widget(registrationForm.plainPassword2) }}
                </div>

                <div class="rowinput">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    <label for="{{ registrationForm.agreeTerms.vars.id }}">
                        J'accepte les <a href="{{ path('app_terms') }}" class='terms'>CGU</a> de GreenGoodies
                    </label>
                </div>

                <button type="submit">S'inscrire</button>

                <a href="{{path('app_login')}}" class="alreadyHaveAccount">Déjà un compte ? Se connecter</a>

            {{ form_end(registrationForm) }}

        </div>
    </div>
</div>



{% endblock %}