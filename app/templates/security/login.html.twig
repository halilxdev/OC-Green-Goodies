{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
 
<link href="{{ asset('css/login.css') }}" rel="stylesheet" type="text/css"/>
 
<section class="loginPage">
    <section class="loginPageMaxWidth">

        <div class="image">
            <img src="{{asset('images/bdc764f53d56d2aa94c157b36fcfc7d9f2db7fa3.jpg')}}" alt="Image de feuilles. Illustration">
        </div>

        <div class="form">

            <div class="title">
                <h1>Connexion</h1>
            </div>

            {% if error %}
                <div class="error">
                    <img src="{{asset('icons/alert-circle-sharp.svg')}}" alt="Icône d'erreur">
                    <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('logout') }}">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="POST" action="{# {{path('processLogin')}} #}">

                <div class="colinput">
                    <label for="email">Adresse mail</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
                </div>
            
                <div class="colinput">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button type="submit">
                    Se connecter
                </button>

                <a href="{{path('register')}}" class="alreadyHaveAccount">Pas encore de compte ? S'inscrire</a>

            </form>

        </div>
    </div>
</div>

{% endblock %}